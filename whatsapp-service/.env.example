# Copia este archivo como .env y ajusta los valores. El .env no se sube a git.
NODE_ENV=production

# Servicio interno: solo escucha en localhost; nginx lo expone en https://kratos.net.pe/wa/
HOST=127.0.0.1
PORT=4010
PUBLIC_ORIGINS=https://kratos.net.pe,https://www.kratos.net.pe

# Mismo valor que JWT_SECRET del backend de KRATOS: el panel valida con el su JWT
# (no tiene login propio). Entran los cargos jefatura (admin) y backoffice.
KRATOS_JWT_SECRET=

# Clave para que el servicio registre en la Base de KRATOS a quien escribe por WhatsApp.
# Debe ser la misma que INTERNAL_PRIZMA_KEY del backend (backend/.env).
KRATOS_INTERNAL_KEY=
KRATOS_API_URL=http://127.0.0.1:4100

# Opcional: bienvenida automática a los chats nuevos (off | on) y líneas donde aplica
# WA_AUTO_BIENVENIDA=off
# WA_AUTO_BIENVENIDA_LINEAS=
