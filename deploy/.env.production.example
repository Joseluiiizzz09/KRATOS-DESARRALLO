# Copiar a backend/.env en el servidor y completar. NUNCA subir este archivo con valores reales.

# Base de datos (crear base y usuario propios de KRATOS, no usar root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=kratos_app
DB_PASSWORD=CAMBIAR_clave_larga_y_unica
DB_NAME=kratos

# Seguridad: generar con  openssl rand -hex 48
JWT_SECRET=CAMBIAR_valor_aleatorio_largo
# Clave del usuario "admin" (Jefatura). Se crea la primera vez que arranca el servidor.
ADMIN_PASSWORD=CAMBIAR_clave_de_jefatura

# Puerto interno (solo lo ve Nginx). Revisar que no lo use otro servicio:  ss -ltnp
PORT=4100
# Direccion publica desde la que se abre KRATOS (CORS). Varias separadas por coma.
FRONTEND_URL=http://200.234.235.164:8081

GOOGLE_SHEETS_RECLUTAMIENTO_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
